# Kopiere diese Datei nach .env (wird nie committed). In GitHub: Settings > Secrets and variables > Actions.
ANTHROPIC_API_KEY=

# Facebook-Seite (Graph API, Berechtigungen: pages_manage_posts, pages_read_engagement)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# Instagram Business-/Creator-Konto (Berechtigung: instagram_content_publish)
INSTAGRAM_USER_ID=
INSTAGRAM_TOKEN=

# TikTok Content Posting API (Scope: video.publish bzw. video.upload)
TIKTOK_ACCESS_TOKEN=
