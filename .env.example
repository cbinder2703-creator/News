# Kopiere diese Datei nach .env (wird nie committed). In GitHub: Settings > Secrets and variables > Actions.
ANTHROPIC_API_KEY=

# Sprecherstimme (ElevenLabs, optional; ohne Key werden stumme Videos erzeugt)
ELEVENLABS_API_KEY=

# Freigabe per WhatsApp (optional, siehe README): Cloud API von Meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=          # deine Nummer mit Ländervorwahl, nur Ziffern (z. B. 49151...)

# Facebook-Seite (Graph API, Berechtigungen: pages_manage_posts, pages_read_engagement)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# Instagram Business-/Creator-Konto (Berechtigung: instagram_content_publish)
INSTAGRAM_USER_ID=
INSTAGRAM_TOKEN=

# TikTok Content Posting API (Scope: video.publish bzw. video.upload)
TIKTOK_ACCESS_TOKEN=
